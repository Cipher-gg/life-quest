# Copy this file to `.env` and fill in the values below.
# `.env` is gitignored — never commit secrets.

# === Cloudflare Tunnel ===
# Get this from:
#   Cloudflare Zero Trust dashboard -> Networks -> Tunnels
#   -> your tunnel -> copy the token from the install command.
TUNNEL_TOKEN=

# === Cloudflare Access ===
# Your team domain (Zero Trust -> Settings -> Custom Pages, or look at the URL
# of the Zero Trust dashboard: <team>.cloudflareaccess.com).
# Example: mycompany.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=

# The Application Audience (AUD) tag.
#   Zero Trust -> Access -> Applications -> your life-quest app -> Overview
#   -> "Application Audience (AUD) Tag". Long hex string.
CF_ACCESS_AUD=
